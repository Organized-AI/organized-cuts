  "transcript": [
    {
      "start": 460.0,
      "end": 468.2,
      "text": "Raw scores don't sum to one, so we push them through a softmax."
    },
    {
      "start": 468.4,
      "end": 476.0,
      "text": "Watch the temperature term — high T flattens the distribution, low T sharpens it."
    },
    {
      "start": 1083.0,
      "end": 1092.5,
      "text": "Each query dots against every key. We divide by root d-k so the variance doesn't blow up."
    },
    {
      "start": 1598.0,
      "end": 1607.0,
      "text": "People ask why GELU and not ReLU — it's that smooth gate near zero."
    },
    {
      "start": 1870.0,
      "end": 1880.0,
      "text": "Let's write the stabilized softmax in NumPy — subtract the max before you exponentiate."
    }
  ],
