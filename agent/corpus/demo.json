      "title": "Softmax in NumPy",
      "clip": 4,
      "t": 1872.0,
      "props": {
        "code": "# stabilized softmax — subtract the max\nimport numpy as np\n\ndef softmax(z, T=1.0):\n    z = np.asarray(z) / T\n    e = np.exp(z - z.max())\n    return e / e.sum()\n\nlogits = [3.1, 1.4, 0.6, -0.8]\nprint(softmax(logits).round(3))",
        "output": "[0.78  0.142 0.064 0.016]\n# argmax → token 0 (0.780)"
      }
